# Firebase web config (public — safe to expose in the client bundle).
# Copy to .env.local and fill in. In production these are set as Vercel env vars.
VITE_FIREBASE_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated admin emails — UI gating only (real authorization is server-side)
VITE_ADMIN_EMAILS=
