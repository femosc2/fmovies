{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --prefix client && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://fmovies-7dd88.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://fmovies-7dd88.firebaseapp.com/__/firebase/:path*"
    },
    { "source": "/((?!api/|__/).*)", "destination": "/index.html" }
  ]
}
